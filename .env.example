# --- required for real runs (without it every demo runs in offline mock mode) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-nano
# minimal | low | medium | high
OPENAI_REASONING_EFFORT=low

# --- optional ---
# EMBEDDINGS_BACKEND=openai          # default "local" (free hashing embedder)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODE=mock                      # force offline mode
# ROUTER_ENABLE_MINI=1               # P7: allow escalation to gpt-5-mini
# WEB_SEARCH_MODEL=gpt-5-nano        # P2 fallback search (Responses API web_search tool)
# WEBHOOK_SECRET=change-me           # P8 HMAC secret
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   # P11 alerts
# LANGSMITH_API_KEY=lsv2_...         # P11 tracing to LangSmith (pip install langsmith)
# LANGSMITH_PROJECT=genai-agentic-projects
